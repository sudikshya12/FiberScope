# Copy to .env (Compose) or export in your shell (local dev). Never commit real tokens.

# --- API ---
# Default: backend/data/fiberscope.db (local) or /data/fiberscope.db (Docker)
# FIBERSCOPE_DATABASE_URL=sqlite:///./data/fiberscope.db
FIBERSCOPE_CORS_ORIGINS=http://localhost:5188,http://127.0.0.1:5188
# Run Alembic migrations + idempotent seed on API start (1/0)
FIBERSCOPE_AUTO_MIGRATE=1

# --- Optional Linux lab (off by default) ---
FIBERSCOPE_LINUX_LAB_ENABLED=0
FIBERSCOPE_LAB_RUNNER_URL=http://127.0.0.1:8765
# >= 32 random characters, e.g. `openssl rand -hex 24`
FIBERSCOPE_LAB_RUNNER_TOKEN=
# Runner-side explicit activation (read by labrunner only)
FIBERSCOPE_LAB_ENABLE=0

# --- Frontend dev proxy target ---
FIBERSCOPE_API_URL=http://127.0.0.1:8077
